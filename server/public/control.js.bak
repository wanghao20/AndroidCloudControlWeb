    if (el) el.onclick = handler;
}

bindClick("btnRecents", () => sendControl({ type: "recents" }));

bindClick("btnInputText", () => {
    const text = prompt("请输入文本");
    if (!text) return;
    sendControl({ type: "input", text });
});
/* ================= capture speed 控制按钮 ================= */
const btnSetHighSpeed = document.getElementById("btnSetHighSpeed");
const btnSetLowSpeed = document.getElementById("btnSetLowSpeed");

if (btnSetHighSpeed) {
    btnSetHighSpeed.onclick = () => {
        sendControl({
            type: "setCaptureSpeed",
            speed: "high"
        });
        if (viewerTips) viewerTips.innerHTML = "🔴 已切换为实时监控（高帧率）";
        updateCaptureStatusDisplay("high");
    };
}

if (btnSetLowSpeed) {
    btnSetLowSpeed.onclick = () => {
        sendControl({
            type: "setCaptureSpeed",
            speed: "low"
        });
        if (viewerTips) viewerTips.innerHTML = "🟢 已切换为节省流量（低帧率）";
        updateCaptureStatusDisplay("low");
    };
}

const btnUploadFile = document.getElementById("btnUploadFile");
const deviceFileInput = document.getElementById("deviceFileInput");
const deviceUploadStatus = document.getElementById("deviceUploadStatus");
if (btnUploadFile && deviceFileInput) {
    btnUploadFile.addEventListener("click", () => {
        deviceFileInput.value = "";
        deviceFileInput.click();
    });
}
if (deviceFileInput) {
    deviceFileInput.addEventListener("change", async (event) => {
        const file = event.target.files?.[0];
        if (!file) return;
        await uploadFileToDevice(file);
    });
}

async function uploadFileToDevice(file) {
    if (!file) return;
    if (!deviceUploadStatus) return;
    deviceUploadStatus.textContent = "上传中…";
    const formData = new FormData();
    formData.append("file", file);
    formData.append("deviceId", deviceId);

    try {
        const resp = await fetch("/api/upload", {
            method: "POST",
            headers: { "x-admin-token": token || "" },
            body: formData,
        });
        const data = await resp.json();
        if (!resp.ok) {
            deviceUploadStatus.textContent = `上传失败：${data.message || "服务器错误"}`;
            return;
        }
        deviceUploadStatus.textContent = `下发成功：${data.url}`;
    } catch (err) {
        deviceUploadStatus.textContent = `上传失败：${err.message}`;
    }
    setTimeout(() => {
        if (deviceUploadStatus) deviceUploadStatus.textContent = "";
    }, 5000);
}

/* ================= 网速检测 ================= */

const btnSpeedTest = document.getElementById("btnSpeedTest");
if (btnSpeedTest) {
    btnSpeedTest.onclick = runSpeedTest;
}

async function runSpeedTest() {
    if (btnSpeedTest) btnSpeedTest.disabled = true;
    const results = { download: 0, upload: 0 };

    try {
        if (viewerTips) viewerTips.innerHTML = "⏳ 正在检测下载速度…";

        const dlSize = 256 * 1024;
        const dlUrl = `/api/speed-test-download?size=${dlSize}&t=${Date.now()}`;
        const dlStart = performance.now();
        const dlResp = await fetch(dlUrl, { cache: "no-store" });
        if (dlResp.ok) {
            const blob = await dlResp.blob();
            const dlEnd = performance.now();
            const dlMs = dlEnd - dlStart;
            results.download = Math.round((blob.size * 8) / (dlMs / 1000) / 1024);
        }

        if (viewerTips) viewerTips.innerHTML = "⏳ 正在检测上传速度…";

        const ulSize = 128 * 1024;
        const ulData = new Uint8Array(ulSize);
        for (let i = 0; i < ulData.length; i++) ulData[i] = Math.random() * 256 | 0;
        const ulBlob = new Blob([ulData]);
        const ulForm = new FormData();
        ulForm.append("data", ulBlob, "speedtest.bin");

        const ulStart = performance.now();
        const ulResp = await fetch("/api/speed-test-upload", {
            method: "POST",
            headers: { "x-admin-token": token || "" },
            body: ulForm,
        });
        const ulEnd = performance.now();
        if (ulResp.ok) {
            const ulMs = ulEnd - ulStart;
            results.upload = Math.round((ulSize * 8) / (ulMs / 1000) / 1024);
        }

        const dlLabel = results.download > 1024
            ? `${(results.download / 1024).toFixed(1)} Mbps`
            : `${results.download} Kbps`;
        const ulLabel = results.upload > 1024
            ? `${(results.upload / 1024).toFixed(1)} Mbps`
            : `${results.upload} Kbps`;

        alert(`网速检测结果\n\n下载：${dlLabel}\n上传：${ulLabel}`);
        if (viewerTips) viewerTips.innerHTML = `网速：下载 ${dlLabel} / 上传 ${ulLabel}`;
    } catch (err) {
        alert(`网速检测失败：${err.message}`);
        if (viewerTips) viewerTips.innerHTML = "网速检测失败";
    } finally {
        if (btnSpeedTest) btnSpeedTest.disabled = false;
    }
}

/* ================= 编码模式切换 ================= */

function updateCodecModeButtons() {
    if (btnCodecBase64) btnCodecBase64.classList.toggle("active", currentCodecMode === "base64");
    if (btnCodecWebp) btnCodecWebp.classList.toggle("active", currentCodecMode === "webp");
    if (btnCodecH264) btnCodecH264.classList.toggle("active", currentCodecMode === "h264");
}

function switchCodecMode(mode) {
    if (mode === currentCodecMode) return;
    currentCodecMode = mode;
    updateCodecModeButtons();

    if (!ws || ws.readyState !== WebSocket.OPEN) return;

    switch (mode) {
        case "base64":
            sendControl({ type: "setCodecMode", mode: "base64" }, { skipFeedback: true });
            sendControl({ type: "resumeCapture" }, { skipFeedback: true });
            sendControl({ type: "setCaptureSpeed", speed: "high" }, { skipFeedback: true });
            webpFallbackRequested = false;
            codecPreferenceSynced = true;
            updateCodecDisplayLayer();
            captureProfileHint = "high";
            updateCaptureStatusDisplay("high");
            if (captureElevated) {
                scheduleControlIdleTimer();
            }
            if (viewerTips) viewerTips.innerHTML = "已切换到 Base64 模式（JPEG·JSON）";
            break;
        case "webp":
            updateCodecDisplayLayer();
            webpFallbackRequested = true;
            codecPreferenceSynced = true;
            sendControl({ type: "setCodecMode", mode: "webp" }, { skipFeedback: true });
            sendControl({ type: "preferWebp" }, { skipFeedback: true });
            sendControl({ type: "resumeCapture" }, { skipFeedback: true });
            sendControl(
                { type: "setCaptureSpeed", speed: pickCaptureSpeedForSession() },
                { skipFeedback: true }
            );
            sendControl({ type: "requestFrame" }, { skipFeedback: true });
            captureElevated = true;
            captureProfileHint = "high";
            captureSessionPrewarmed = true;
            scheduleControlIdleTimer();
            updateCaptureStatusDisplay("high");
            if (viewerTips) viewerTips.innerHTML = "已切换到 WebP 模式（二进制帧）";
            break;
        case "h264":
            updateCodecDisplayLayer();
            if (!canUseWebCodecsH264()) {
                alert("当前环境不支持 H.264 解码（需要 HTTPS 或 localhost）");
                currentCodecMode = "base64";
                updateCodecModeButtons();
                return;
            }
            sendControl({ type: "setCodecMode", mode: "h264" }, { skipFeedback: true });
            sendControl({ type: "allowH264" }, { skipFeedback: true });
            sendControl({ type: "setCaptureSpeed", speed: "high" }, { skipFeedback: true });
            webpFallbackRequested = false;
            codecPreferenceSynced = true;
            if (viewerTips) viewerTips.innerHTML = "已切换到 H.264 模式（硬件解码）";
            break;
    }
    StreamDiag.log("编码模式切换 →", mode);
}

if (btnCodecBase64) btnCodecBase64.addEventListener("click", () => switchCodecMode("base64"));
if (btnCodecWebp) btnCodecWebp.addEventListener("click", () => switchCodecMode("webp"));
if (btnCodecH264) btnCodecH264.addEventListener("click", () => switchCodecMode("h264"));
