            if (uiNodeData) uiNodeData.textContent = "";
        }
        sendControl({ type: "fetchUiNodes" });
    };
}

if (btnCloseUiNodeModal) {
    btnCloseUiNodeModal.onclick = () => {
        if (uiNodeModal) uiNodeModal.classList.add("hidden");
    };
}

if (uiNodeModal) {
    uiNodeModal.addEventListener("click", (e) => {
        if (e.target.classList.contains("ui-node-modal-backdrop")) {
            uiNodeModal.classList.add("hidden");
        }
    });
}

window.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && uiNodeModal) {
        uiNodeModal.classList.add("hidden");
    }
});

function bindClick(id, handler) {
