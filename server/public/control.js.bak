let lastRxStreamFormat = null;
let h264ConfigReceived = false;
let lastFramePaintAt = 0;
/** 本会话是否已向手机请求过 WebP（避免重复刷指令） */
let webpFallbackRequested = false;
let h264NoFrameFallbackTimer = null;
const H264_NO_FRAME_FALLBACK_MS = 800;
const CAPTURE_BOOTSTRAP_RETRY_MS = 2000;
const CAPTURE_BOOTSTRAP_MAX_RETRIES = 3;
/** 控制页无操作超过该时间则降回 low */
const CONTROL_IDLE_LOW_MS = 30000;
let controlIdleLowTimer = null;
/** 是否在控制页 elevated 高刷（离开页 / 30s 无操作后为 false） */
