
const params = new URLSearchParams(window.location.search);
/** 投屏诊断：URL ?diag=1 或 localStorage.streamDiag=1 */
const StreamDiag = {
    enabled() {
        try {
            if (params.has("diag")) return true;
            return localStorage.getItem("streamDiag") === "1";
        } catch (_) {
            return params.has("diag");
        }
    },
    log(...args) {
        if (!this.enabled()) return;
        console.log("[StreamDiag]", ...args);
    },
    warn(...args) {
        if (!this.enabled()) return;
        console.warn("[StreamDiag]", ...args);
    },
};

const deviceId = params.get("id");
const syncGroupParam = params.get("syncGroup");
const syncGroupDeviceIds = syncGroupParam ? syncGroupParam.split(",").filter(Boolean) : [];
const token = localStorage.getItem("adminToken");

