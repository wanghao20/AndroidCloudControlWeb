if (!deviceId) {

    document.body.innerHTML =
        "<div style='padding:40px;text-align:center;color:#ef4444;'>未指定设备ID</div>";

    throw new Error("missing deviceId");
}

/** 仅主屏设备执行的命令（群控时不广播到从机） */
const MASTER_ONLY_COMMANDS = new Set([
    "setCaptureSpeed",
    "fetchUiNodes",
    "pauseCapture",
    "resumeCapture",
]);

function updateGroupControlTitle() {
    if (!deviceTitle) return;
    if (syncGroupDeviceIds.length < 2) {
        deviceTitle.textContent = `设备控制：${deviceId}`;
        if (masterDeviceRow) masterDeviceRow.classList.add("hidden");
        return;
    }
    const shortId = deviceId.length > 8 ? `…${deviceId.slice(-8)}` : deviceId;
    deviceTitle.textContent =
        `设备控制：${deviceId}（群控 ${syncGroupDeviceIds.length} 台 · 主屏 ${shortId}）`;
    if (masterDeviceRow) masterDeviceRow.classList.remove("hidden");
}

function initMasterDeviceSelect() {
    if (!masterDeviceSelect || syncGroupDeviceIds.length < 2) return;
    masterDeviceSelect.innerHTML = syncGroupDeviceIds
        .map((id) => {
            const selected = String(id) === String(deviceId) ? " selected" : "";
            const label = id.length > 16 ? `…${id.slice(-12)}` : id;
            return `<option value="${id}"${selected}>${label}</option>`;
        })
        .join("");
    masterDeviceSelect.onchange = () => {
        const newId = masterDeviceSelect.value;
        if (!newId || String(newId) === String(deviceId)) return;
        const syncParam = encodeURIComponent(syncGroupDeviceIds.join(","));
        window.location.href =
            `device.html?id=${encodeURIComponent(newId)}&syncGroup=${syncParam}`;
    };
}

/** 点击坐标映射到手机真实分辨率（投屏 JPEG 已缩放，不能用 naturalWidth） */
function getDeviceResolution() {
    return {
        w: deviceInfo?.width || 1080,
        h: deviceInfo?.height || 2400,
    };
}

function formatControlAck(msg) {
    const r = msg.result;
    if (r && typeof r.success === "number" && Array.isArray(msg.deviceIds)) {
        const total = msg.deviceIds.length;
        const ok = r.success;
        const failed = r.failed || 0;
        if (failed === 0) {
            return `✅ 群控指令已下发（${ok}/${total}）`;
        }
        const failedIds = (r.failedIds || []).slice(0, 2).join(", ");
        const suffix = (r.failedIds || []).length > 2 ? "…" : "";
        return `⚠️ 部分失败 ${ok}/${total}${failedIds ? `，失败：${failedIds}${suffix}` : ""}`;
    }
    const ok = msg.success === true || (r && r.success > 0);
    return ok ? "✅ 指令已下发" : "❌ 指令下发失败";
}

updateGroupControlTitle();
initMasterDeviceSelect();

let ws = null;
/** 控制页 WebSocket 是否已 open（与手机是否在线无关） */
let controlWsConnected = false;
let deviceInfo = null;
/** 近期收到过实时画面则视为在线（避免 device_list 快照滞后） */
let deviceStreamOnline = false;
/** 收到 device_disconnected 后保持离线，直到再次收帧/注册/服务端确认 */
let deviceForceOffline = false;
let lastDeviceFrameRxAt = 0;
const DEVICE_ONLINE_STALE_MS = 20000;
let deviceMetaRefreshTimer = null;
let wsReconnectTimer = null;
let wsReconnectAttempt = 0;
/** 为 false 时不再重连 WS（已离开控制页） */
let controlSessionActive = true;
/** StreamDiag 会话起点，用于启动 10s 内不刷「收帧偏低」 */
let streamDiagSessionStartedAt = 0;

let isExpanded = false;

let touchTimer = null;

let isLongPressed = false;

let ignoreNextClick = false;
let ignoreNextClickFromPress = false;
let sendControlAnimationTimer = null;
let lastSwipeSentAt = 0;
const SWIPE_THROTTLE_MS = 80;
let swipeCapturingSlow = false;

let frameRafScheduled = false;
let framePaintGeneration = 0;
/** Canvas 内实际画面区域（像素坐标，用于点击换算） */
let lastFrameContentRect = null;

const WEB_FRAME_MAGIC = 0xf2;

const IMAGE_FORMAT_JPEG = 0x00;
const IMAGE_FORMAT_WEBP = 0x01;
const IMAGE_FORMAT_H264 = 0x02;
const H264_FRAME_CONFIG = 0;
const H264_FRAME_KEY = 1;
const H264_FRAME_DELTA = 2;

let h264Decoder = null;
let h264DecoderReady = false;
let h264ChunkTimestampUs = 0;

function canUseWebCodecsH264() {
    return window.CodecClient
        ? CodecClient.canUseWebCodecsH264()
        : typeof VideoDecoder !== "undefined" &&
              typeof EncodedVideoChunk !== "undefined" &&
              window.isSecureContext === true;
}

function getWebCodecsBlockReason() {
    if (window.CodecClient) return CodecClient.getWebCodecsBlockReason();
    if (typeof VideoDecoder === "undefined" || typeof EncodedVideoChunk === "undefined") {
        return "浏览器缺少 VideoDecoder（请用较新 Chrome/Edge）";
    }
    if (!window.isSecureContext) {
        return `当前为 ${location.protocol} 非安全连接，H.264 需 HTTPS 或 localhost`;
    }
    return "";
}

let lastPreferWebpSentAt = 0;

/** 强制手机 WebP（HTTP 可重复下发，直到收流不再是 H.264） */
function forcePreferWebp(reason, options = {}) {
    if (!ws || ws.readyState !== WebSocket.OPEN) return;
    if (currentCodecMode === "base64") return;
    const allowRepeat = options.allowRepeat === true || isPublicHttpPage();
    const now = Date.now();
    if (!allowRepeat && webpFallbackRequested) return;
    if (allowRepeat && now - lastPreferWebpSentAt < 800) return;
    lastPreferWebpSentAt = now;
    webpFallbackRequested = true;
    const msg = reason || "网页无法解码 H.264";
    console.warn("[codec] 请求手机改用 WebP:", msg);
    sendControl({ type: "preferWebp" }, { skipFeedback: true });
    updateCaptureStatusDisplay();
    if (viewerTips && options.updateTips !== false) {
        viewerTips.innerHTML = `⚠️ ${msg}，已通知手机改用 WebP`;
    }
}

function requestWebpFallback(reason) {
    forcePreferWebp(reason, { allowRepeat: false, updateTips: true });
}

function getDefaultViewerQuality() {
    return isPublicHttpPage() ? "smooth" : "quality";
}

function getViewerQualityMode() {
    try {
        const v = localStorage.getItem(STORAGE_VIEWER_QUALITY);
        if (v === "smooth" || v === "quality") return v;
    } catch (_) {
        /* ignore */
    }
    return getDefaultViewerQuality();
}

function setViewerQualityMode(mode) {
    const next = mode === "smooth" ? "smooth" : "quality";
    try {
        localStorage.setItem(STORAGE_VIEWER_QUALITY, next);
    } catch (_) {
        /* ignore */
    }
    updateViewerQualityButtons();
    const speed = pickCaptureSpeedForSession();
    captureProfileHint = speed;
    if (!ws || ws.readyState !== WebSocket.OPEN) return;
    // 「流畅/清晰」只调帧率，不自动改编码（编码仅由 Base64/WebP/H.264 按钮切换）
    if (currentCodecMode === "base64") {
        sendControl({ type: "setCodecMode", mode: "base64" }, { skipFeedback: true });
        codecPreferenceSynced = true;
        if (captureElevated) {
            sendControl({ type: "setCaptureSpeed", speed: "high" }, { skipFeedback: true });
        } else {
            sendControl({ type: "setCaptureSpeed", speed }, { skipFeedback: true });
        }
        updateCaptureStatusDisplay(captureElevated ? "high" : speed);
        StreamDiag.log("画质切换 →", next, "保持 Base64");
        return;
    }
    codecPreferenceSynced = false;
    if (next === "quality" && currentCodecMode !== "base64") {
        syncCaptureCodecPreference({ force: true });
    } else if (next === "quality" && currentCodecMode === "base64") {
        sendControl({ type: "setCodecMode", mode: "base64" }, { skipFeedback: true });
        codecPreferenceSynced = true;
    } else {
        webpFallbackRequested = true;
        codecPreferenceSynced = true;
    }
    sendControl({ type: "setCaptureSpeed", speed }, { skipFeedback: true });
    updateCaptureStatusDisplay(speed);
    StreamDiag.log("画质切换 →", next, "setCaptureSpeed", speed);
}

function updateViewerQualityButtons() {
    const mode = getViewerQualityMode();
    const btnSmooth = document.getElementById("btnQualitySmooth");
    const btnQuality = document.getElementById("btnQualityHigh");
    if (btnSmooth) btnSmooth.classList.toggle("active", mode === "smooth");
    if (btnQuality) btnQuality.classList.toggle("active", mode === "quality");
}

function initViewerQualityBar() {
    captureProfileHint = pickCaptureSpeedForSession();
    updateViewerQualityButtons();
    const btnSmooth = document.getElementById("btnQualitySmooth");
    const btnQuality = document.getElementById("btnQualityHigh");
    if (btnSmooth) {
        btnSmooth.addEventListener("click", () => setViewerQualityMode("smooth"));
    }
    if (btnQuality) {
        btnQuality.addEventListener("click", () => setViewerQualityMode("quality"));
    }
}

/** 按浏览器能力同步编码（仅 webp/h264 用户选项；Base64 模式不自动 preferWebp/allowH264） */
function syncCaptureCodecPreference(options = {}) {
    if (!ws || ws.readyState !== WebSocket.OPEN) return;
    if (currentCodecMode === "base64") {
        codecPreferenceSynced = true;
        return;
    }
    const force = options.force === true;
    if (!force && codecPreferenceSynced) return;

    if (getViewerQualityMode() === "smooth") {
        sendControl({ type: "preferWebp" }, { skipFeedback: true });
        webpFallbackRequested = true;
        codecPreferenceSynced = true;
        return;
    }

    if (window.CodecClient) {
        CodecClient.detectAndPersist();
        const cmd = CodecClient.getCodecCommand();
        if (cmd.type === "allowH264" && canUseWebCodecsH264()) {
            webpFallbackRequested = false;
            sendControl(cmd, { skipFeedback: true });
            codecPreferenceSynced = true;
        } else {
            forcePreferWebp(
                CodecClient.getWebCodecsBlockReason() || "网页不支持 H.264 解码",
                { allowRepeat: true, updateTips: false }
            );
            codecPreferenceSynced = true;
        }
        return;
    }
    if (canUseWebCodecsH264()) {
        webpFallbackRequested = false;
        sendControl({ type: "allowH264" }, { skipFeedback: true });
        codecPreferenceSynced = true;
    } else {
        forcePreferWebp(getWebCodecsBlockReason() || "网页不支持 H.264 解码", {
            allowRepeat: true,
            updateTips: false,
        });
        codecPreferenceSynced = true;
    }
}

function clearH264NoFrameFallbackTimer() {
    if (h264NoFrameFallbackTimer) {
        clearTimeout(h264NoFrameFallbackTimer);
        h264NoFrameFallbackTimer = null;
    }
}

/** 已收 H.264 CONFIG 但长时间无画面 → 自动 preferWebp */
function scheduleH264NoFrameFallback() {
    clearH264NoFrameFallbackTimer();
    if (!canUseWebCodecsH264() || webpFallbackRequested) return;
    h264NoFrameFallbackTimer = setTimeout(() => {
        h264NoFrameFallbackTimer = null;
        if (
            lastRxStreamFormat === "h264" &&
            h264ConfigReceived &&
            !lastFramePaintAt &&
            !webpFallbackRequested
        ) {
            requestWebpFallback("H.264 长时间无画面");
        }
    }, H264_NO_FRAME_FALLBACK_MS);
}

