<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/tg_card_bg"
    app:cardCornerRadius="20dp"
    app:cardElevation="8dp"
    app:strokeWidth="1dp"
    app:strokeColor="#40FFFFFF">

    <LinearLayout
        android:id="@+id/ll_container"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="2dp">

        <!-- 悬浮窗入口图标 (点击展开/收起菜单) -->
        <ImageView
            android:id="@+id/iv_menu"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="8dp"
            android:src="@drawable/add_data"
            app:tint="@color/tg_accent" />

        <!-- 展开后的功能面板 -->
        <LinearLayout
            android:id="@+id/ll_panel"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <View
                android:layout_width="1dp"
                android:layout_height="16dp"
                android:layout_marginHorizontal="4dp"
                android:background="#20FFFFFF" />

            <!-- 启动/停止脚本按钮 -->
            <ImageView
                android:id="@+id/iv_run_toggle"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="8dp"
                android:src="@android:drawable/ic_media_play"
                app:tint="#FFFFFF" />

            <!-- 日志开关按钮 -->
            <ImageView
                android:id="@+id/iv_log_toggle"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="8dp"
                android:src="@drawable/p"
                app:tint="#FFFFFF" />

            <!-- 彻底关闭并停止所有按钮 -->
            <ImageView
                android:id="@+id/iv_stop_all"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="8dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="#EF595F" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
