<resources>
    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/ch_cyan</item>
        <item name="colorPrimaryDark">@color/ch_bg</item>
        <item name="colorAccent">@color/ch_magenta</item>

        <item name="android:windowBackground">@color/ch_bg</item>
        <item name="android:textColor">@color/ch_text</item>

        <item name="android:windowTranslucentNavigation">true</item>
        <item name="android:statusBarColor">#00000000</item>

        <!-- Optional: Better tech look for cards -->
        <item name="materialCardViewStyle">@style/Widget.CyberHUD.CardView</item>
    </style>

    <style name="Widget.CyberHUD.CardView" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/ch_panel</item>
        <item name="cardCornerRadius">2dp</item>
        <item name="cardElevation">4dp</item>
        <item name="strokeColor">@color/ch_border</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="CyberHUD.Text" parent="">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/ch_text</item>
    </style>

    <style name="CyberHUD.Text.Title" parent="CyberHUD.Text">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ch_cyan</item>
        <item name="android:letterSpacing">0.1</item>
    </style>

    <style name="CyberHUD.Text.Label" parent="CyberHUD.Text">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/ch_text_dim</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="MyDialog" parent="Theme.MaterialComponents.Light.Dialog">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
</resources>
